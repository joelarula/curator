// ─────────────────────────────────────────────────────────────────────────────
// Canonical PostgreSQL Core Schema
// Main enterprise backend models (Postgres + pgvector).
// For multi-database architecture and synchronization rules across SQLite &
// MariaDB (curator/prisma-*), see AGENTS.md Section 4.6.
// ─────────────────────────────────────────────────────────────────────────────

enum RequestStatus {
  NEW
  WAITING
  WAITING_FOR_USER
  WAITING_FOR_EVENT
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
  SKIPPED
}

model Project {
  id          String    @id @default(cuid())
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  resources   Resource[]
  relations   Relation[]
  scripts     Script[]
  agents      Agent[]
  requests    Request[]
  conversations Conversation[]
  responses   Response[]
  resourceTrees ResourceTree[]
  dslSchemas  DslSchema[]
  roles       Role[]
  projectRoles ProjectRole[]
  userRoles   UserRole[]
  mcpServers  McpServer[]
  tools       Tool[]

  /// Parent project (sub-project / workspace). Agents defined in a project may act in its sub-projects.
  parentId      String?
  existent    Boolean?  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, existent])
  @@index([parentId])
}


model Tool {
  id                   Int          @id @default(autoincrement())
  name                 String       @unique // e.g. "upsert_resource", "categorize_article"
  description          String?      @db.Text
  version              String? // semver, e.g. "1.0.0"
  accessLevel          String       @default("safe_write")
  requiredRole         String?      // Exact role required to whitelist this tool
  requiresConfirmation Boolean      @default(false)
  requiresHumanApproval Boolean     @default(false)
  roles                ToolRole[]
  enabled              Boolean      @default(true)
  origin               String       @default("local") // local | remote
  mcpServerId          Int?
  mcpServer            McpServer?   @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  remoteName           String?      // tool name on the remote provider
  projectId            String?      // set for remote tools (= McpServer.projectId); null for local tools
  project              Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inputSchema          Json?
  annotations          Json?        // remote hints (readOnlyHint, destructiveHint, ...), untrusted
  existent             Boolean?     @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([existent])
  @@unique([mcpServerId, remoteName])
  @@index([origin])
  @@index([projectId])
}









model Resource {
  id                 Int               @id @default(autoincrement())
  uri                String            
  title              String?           @db.VarChar(255)
  description        String?           @db.Text
  isPublished        Boolean           @default(false)
  
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id])

  metadata           Json?             // Extensible storage for external IDs, AI confidence, etc.
  
  existent           Boolean?          @default(true)
  deletedAt          DateTime?         // Soft delete timestamp
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt


  requests           Request[]         @relation("RequestResources")
  conversations      Conversation[]    @relation("ConversationResources")
  texts              Text[]            @relation("ResourceTexts")
  subjectRelations   Relation[]        @relation("RelationSubject")
  predicateRelations Relation[]        @relation("RelationPredicate")
  objectRelations    Relation[]        @relation("RelationObject")
  treeNodes          ResourceTree[]
  attachments        Attachment[]

  @@unique([uri])                       // Studio-wide URI identity
  @@unique([id, existent])              // ID/Existent compound uniqueness
  @@index([uri, existent])
  @@index([existent])
  @@index([deletedAt])
  @@index([projectId])

}




model Text {
  resourceId  Int?
  resource    Resource? @relation("ResourceTexts", fields: [resourceId], references: [id])
  id          String    @id @default(cuid())
  content     String    @db.Text
  role        String    @default("MAIN")
  mimeType    String?   @default("text/plain")
  extension   String?   @default("txt")

  isPublished Boolean   @default(false)
  existent    Boolean?  @default(true)
  deletedAt   DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([resourceId, existent])
  @@index([existent])
  @@unique([resourceId, role])
}


model Relation {
  id             Int          @id @default(autoincrement())
  subjectId      Int
  predicateId    Int
  objectId       Int
  subject        Resource     @relation("RelationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  predicate      Resource     @relation("RelationPredicate", fields: [predicateId], references: [id], onDelete: Cascade)
  object         Resource     @relation("RelationObject", fields: [objectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  aiModelId      Int?
  aiModel        AIModel?     @relation(fields: [aiModelId], references: [id])


  
  literalValue     Float?
  literalString    String?   @db.Text
  literalDate      DateTime?
  literalBoolean   Boolean?
  literalDatatype  String?   // RDF Datatype URI (e.g. xsd:string)

  selectionStart Int?
  selectionEnd   Int?


  justification String?

  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])

  existent      Boolean? @default(true)

  @@unique([subjectId, predicateId, objectId])
  @@index([subjectId, existent])
  @@index([predicateId, existent])
  @@index([objectId, existent])
  @@index([existent])
  @@index([projectId])

}



model Attachment {
  resourceId Int?
  resource   Resource? @relation(fields: [resourceId], references: [id])
  id         String    @id @default(cuid())
  uri        String    @unique
  filename   String
  mimetype   String
  url        String
  size       Int
  existent   Boolean?  @default(true)
  createdAt  DateTime  @default(now())

  @@index([existent])
}


model AIModel {
  id        Int     @id @default(autoincrement())
  shortName String  @unique // e.g. "distilbert", "gpt-4"
  name      String  @unique // e.g. "Xenova/distilbert-base-uncased-mnli"
  provider  String // e.g. "HuggingFace", "OpenAI"
  type      String // e.g. "GENERATIVE", "EMBEDDING"
  version   String?
  url       String?

  requests  Request[]
  responses Response[]
  relations Relation[]



  deletedAt DateTime?
  existent  Boolean? @default(true)
  createdAt DateTime @default(now())

  @@index([existent])
}



model Script {
  id        Int       @id @default(autoincrement())
  name      String
  body      String?   @db.Text // The dynamic logic (JS)
  toolCalls Json? // Legacy
  ast       Json? // Formal Execution AST
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])

  requests  Request[]
  agents    Agent[]
  eventSubscriptions EventSubscription[]
  /// Points to ScriptVersion.version that is active. Script.ast/body mirror it (deprecated, kept for compatibility).
  currentVersion Int @default(0)
  versions       ScriptVersion[]
  existent  Boolean? @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())


  @@index([existent])



  @@unique([name])
}

/// Immutable definition history. A new row is created only when the AST hash changes.
model ScriptVersion {
  id        Int      @id @default(autoincrement())
  scriptId  Int
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  version   Int
  hash      String
  ast       Json?
  body      String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([scriptId, version])
  @@unique([scriptId, hash])
}

model Request {
  /// ScriptVersion.version executed (with scriptId). Request.ast is null in reference mode.
  scriptVersion      Int?
  id         Int           @id @default(autoincrement())
  status     RequestStatus @default(NEW)
  toolName   String?
  retryCount Int           @default(0)

  scriptId  Int?
  script    Script?    @relation(fields: [scriptId], references: [id])
  aiModelId Int?
  aiModel   AIModel?   @relation(fields: [aiModelId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id])

  ast       Json? // Formal Execution AST
  context   Json?
  /// Output of a finished control-flow step (history steps write Responses instead), read by the step it notifies.
  output    String?


  resources Resource[] @relation("RequestResources")

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
  scheduledAt    DateTime     @default(now())

  executionScheduled DateTime? @default(now())

  // Execution (CuratorRequestProcessor): claim order, the request to notify when done, dependencies still running
  priority            Int  @default(0)
  notifyId            Int?
  pendingDependencies Int  @default(0)
  /// Highest EventLog.id this flow has consumed or emitted; wait_event replays later events so none are lost.
  eventCursor         Int?

  lockedBy       String?
  lockedAt       DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses      Response[]

  // Workflow tracking
  parentId Int?
  /// Request that created this one (lineage: fork replay rebuilds the run's tree from it). Covers parentId (a subset with cancel semantics).
  createdBy Int?
  parent   Request?  @relation("Workflow", fields: [parentId], references: [id])
  children Request[] @relation("Workflow")

  existent Boolean? @default(true)

  @@index([status, existent])
  @@index([existent])
  @@index([conversationId, status])
  @@index([conversationId, updatedAt])
  @@index([parentId])
  @@index([conversationId, createdBy])
  @@index([notifyId])
}


model Response {

  id             Int          @id @default(autoincrement())
  requestId      Int
  request        Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  content        String       @db.Text
  aiModelId      Int?
  aiModel        AIModel?     @relation(fields: [aiModelId], references: [id])

  projectId      String?
  /// User who wrote it (a human answer); null for engine output.
  userId         String?
  project        Project?     @relation(fields: [projectId], references: [id])

  existent       Boolean?     @default(true)

  createdAt      DateTime     @default(now())

  @@index([existent])
  @@index([requestId])
  @@index([conversationId, createdAt])
}


model Conversation {
  id         Int        @id @default(autoincrement())
  externalId String     @unique @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id])

  requests   Request[]

  responses  Response[]
  resources  Resource[] @relation("ConversationResources")
  metadata   Json?
  existent   Boolean?   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  @@index([existent])
}



model ResourceTree {
  id         Int      @id @default(autoincrement())
  treeName   String   @db.VarChar(100)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  parentId   Int?
  parent     ResourceTree?  @relation("TreeHierarchy", fields: [parentId], references: [id])
  children   ResourceTree[] @relation("TreeHierarchy")

  treeStart  Float
  treeEnd    Float
  depth      Int      @default(0)

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])

  deletedAt  DateTime?

  existent   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([treeName, resourceId])
  @@index([treeName, treeStart, treeEnd, existent])
  @@index([existent])
  @@index([deletedAt])
}






/// Materialized from event declarations in a Script AST; the AST is the source of truth.
/// Firing is recorded as the spawned child Request, never here.
model EventSubscription {
  id             Int      @id @default(autoincrement())
  eventName      String
  scriptId       Int
  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId Int?
  userId         String
  projectId      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Subroutine name in the Script module; null = main.
  entry          String?
  /// Filter expression copied from the declaration.
  when           String?
  /// Handler param receiving the payload (declaration `as`); null = 'event'.
  payloadAs      String?

  @@unique([scriptId, entry, eventName, conversationId])
  @@index([eventName, isActive])
}

model Agent {
  id           String    @id @default(cuid())
  uri          String?   @unique // Semantic RDF Identity (e.g. agent:news_curator)
  name         String
  description  String?   @db.Text
  systemPrompt String?   @db.Text
  avatar       String?
  scriptId     Int
  script       Script    @relation(fields: [scriptId], references: [id])
  schedule     String    @default("every 10 minutes")
  lastPolledAt DateTime?
  userId       String
  user         User      @relation(fields: [userId], references: [id])

  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])

  enabled      Boolean     @default(true)
  roles        AgentRole[]
  toolApprovals ToolApproval[]

  /// Agent that created this one (sub-agent lineage). An agent may manage only its own descendants.
  parentAgentId String?
  existent     Boolean?    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  requests     Request[]
  eventSubscriptions EventSubscription[]

  @@unique([name])
  @@index([existent])
  @@index([parentAgentId])
}


model DslSchema {
  id          String    @id @default(cuid())
  name        String    // e.g. "NewsArticle"
  type        String    // "MODEL" | "ENUM" | "PREDICATE"
  definition  String    @db.Text // The SASL definition snippet

  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])

  existent    Boolean?  @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, name])
  @@index([existent])
  @@index([projectId])
}

// Engine tables, in sync with curator/prisma-postgres/schema.prisma

/// Per-conversation state log: the `__state.*` events that `Conversation.metadata` is folded from (compacted when a
/// conversation finishes). Dispatched events are in BusEvent.
model EventLog {
  id             Int      @id @default(autoincrement())
  conversationId Int
  eventName      String
  payload        Json?
  target         String?
  source         Int?
  createdAt      DateTime @default(now())

  @@index([conversationId, eventName, id])
}

/// Every dispatched event of a conversation (the mailbox behind lossless wait_event; `Request.eventCursor` points
/// at its ids; agents' `history_events` read it). Retired by age (default 30 days): day partitions on
/// Postgres/MariaDB, so no foreign keys and the time column in the primary key.
model BusEvent {
  id             Int      @default(autoincrement())
  conversationId Int
  eventName      String
  payload        Json?
  target         String?
  source         Int?
  createdAt      DateTime @default(now())

  @@id([id, createdAt])
  @@index([conversationId, eventName, id])
  @@index([createdAt])
}

/// Which worker runs a conversation now (docs/DISTRIBUTED_STORAGE_PLAN.md, Phase 4). Held while that worker has
/// requests of the conversation in flight, renewed every poll tick, free for any worker once `leaseUntil` passes.
model ConversationLease {
  conversationId Int      @id
  owner          String
  leaseUntil     DateTime
  updatedAt      DateTime @updatedAt

  @@index([owner])
}

/// Finished-step trace (docs/DISTRIBUTED_STORAGE_PLAN.md, Phase 5): one row per finished Request, written in
/// batches. Observability only, never read by the engine. No foreign keys and the time column in the primary key,
/// so it can be partitioned by time and retired by dropping partitions.
model StepTrace {
  id             Int       @default(autoincrement())
  createdAt      DateTime  @default(now())
  conversationId Int
  requestId      Int
  projectId      String?
  nodeType       String?
  status         String
  output         String?
  /// Replayable steps (agent, tool, reducer, human input, event wait): node hash and the context the step ended with
  /// (contexts are trimmed); a fork returns the recorded result instead of running the step again. Roots: context.
  astHash        String?
  context        Json?
  startedAt      DateTime?
  worker         String?

  @@id([id, createdAt])
  @@index([conversationId, createdAt])
  @@index([requestId])
}

/// What was actually sent to an LLM: one row per call, the request as sent and its response (debug trace, off unless
/// enabled, see src/engine/llm/LlmTrace.ts). Append-only, written in batches and retired by age: day partitions on
/// Postgres/MariaDB, so no foreign keys and the time column in the primary key.
model LlmCall {
  id             Int      @default(autoincrement())
  createdAt      DateTime @default(now())
  conversationId Int
  requestId      Int
  projectId      String?
  /// Agentic loop iteration, or 'summary' (history compaction).
  turn           String
  provider       String?
  model          String?
  request        Json
  response       Json?
  error          String?
  ms             Int?

  @@id([id, createdAt])
  @@index([conversationId, createdAt])
  @@index([requestId])
}

/// Lightweight numeric usage and context telemetry for LLM requests.
/// Observability and cost analysis; append-only, written in batches, retired by age.
model LlmTelemetry {
  id               Int      @default(autoincrement())
  createdAt        DateTime @default(now())
  projectId        String   @default("system")
  userId           String?
  conversationId   Int
  requestId        Int
  turn             Int      @default(1)
  provider         String
  model            String
  status           String
  finishReason     String?
  requestChars     Int
  responseChars    Int
  estimatedTokens  Int?
  promptTokens     Int?
  completionTokens Int?
  cachedTokens     Int?
  totalTokens      Int?
  latencyMs        Int

  @@id([id, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, conversationId, createdAt])
  @@index([conversationId, turn])
  @@index([requestId])
}

/// Saved plugin configuration values (configSchema, see PluginConfigService). Workflows see them merged into
/// `$config`: plugin defaults < system < project < user. Scope keys are never NULL, so the unique key holds:
/// system = ('system', ''), project = (projectId, ''), user = (projectId, userId). Soft delete: existent = NULL.
model PluginConfigValue {
  id        Int      @id @default(autoincrement())
  namespace String
  key       String
  /// system | project | user
  scope     String
  projectId String   @default("system")
  userId    String   @default("")
  value     Json?
  updatedBy String?
  existent  Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, scope, projectId, userId, existent])
  @@index([projectId, userId, existent])
}

/// Prompt library: prompts saved per project (composer `/`, CLI), with `{name}` placeholders for arguments.
/// Deleted rows have `existent` NULL (outside the unique key).
model SavedPrompt {
  id          Int      @id @default(autoincrement())
  projectId   String   @default("system")
  name        String
  title       String?
  description String?
  text        String
  /// [{ name, description?, required? }]; derived from the placeholders when not given
  arguments   Json?
  createdBy   String?
  existent    Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name, existent])
  @@index([projectId, existent])
}
