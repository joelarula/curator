model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  googleId        String?          @unique
  consents        UserConsent[]
  sessions        Session[]
  roles           UserRole[]
  quotas          UserQuota[]
  texts           Text[]
  resources       Resource[]
  scripts         Script[]
  requests        Request[]
  conversations   Conversation[]
  agents          Agent[]
  projects        Project[]




  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Role {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?           @db.Text
  users       UserRole[]
  agents      AgentRole[]
  permissions RolePermission[]
  parentRoles RoleInheritance[] @relation("SubRole")
  subRoles    RoleInheritance[] @relation("ParentRole")

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleInheritance {
  parentId String
  parent   Role   @relation("ParentRole", fields: [parentId], references: [id], onDelete: Cascade)
  subRoleId String
  subRole  Role   @relation("SubRole", fields: [subRoleId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([parentId, subRoleId])
}

model Permission {
  id                   String           @id @default(cuid())
  name                 String           @unique
  description          String?          @db.Text
  toolName             String?
  tool                 Tool?            @relation(fields: [toolName], references: [name], onDelete: Cascade)
  accessLevel          String?
  requiresConfirmation Boolean          @default(false)
  roles                RolePermission[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@id([userId, roleId])
}

model AgentRole {
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@id([agentId, roleId])
}

model UserQuota {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  limit   Int
  usage   Int      @default(0)
  resetAt DateTime

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@unique([userId, type])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String   @unique
  expiresAt       DateTime
  activeProjectId String?

  deletedAt DateTime?
  createdAt DateTime @default(now())


  consents UserConsent[]
}

model UserConsent {
  id      String             @id @default(cuid())
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsId String
  terms   TermsAndConditions @relation(fields: [termsId], references: [id])

  entityType String?
  entityId   String?

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  consentType String   @default("GENERAL")
  consentDate DateTime @default(now())

  deletedAt DateTime?


  @@index([userId])
  @@index([termsId])
  @@index([entityId, entityType])
}

model TermsAndConditions {
  id       String        @id @default(cuid())
  version  String        @unique
  content  String        @db.Text
  isActive Boolean       @default(true)
  consents UserConsent[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String?
  metadata   Json?
  timestamp  DateTime @default(now())
}
