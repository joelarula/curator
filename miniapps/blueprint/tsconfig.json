{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@curator/agent-server": ["../../curator/dist/src/index.d.ts"],
      "@curator/agent-server/*": ["../../curator/dist/src/*"],
      "@curator/host": ["../../packages/host/dist/index.d.ts"],
      "@curator/host/config": ["../../packages/host/dist/appConfig.d.ts"],
      "@curator/host/contracts": ["../../packages/host/dist/contracts/index.d.ts"],
      "@curator/host/client": ["../../packages/host/dist/client/index.d.ts"],
      "@curator/host/*": ["../../packages/host/dist/*"],
      "@curator/mcp-server": ["../../packages/mcp-server/dist/index.d.ts"],
      "@curator/mcp-server/*": ["../../packages/mcp-server/dist/*"],
      "@curator/server": ["../../packages/server/dist/index.d.ts"],
      "@curator/server/*": ["../../packages/server/dist/*"],
      "graphql": ["../../miniapps/keeris/node_modules/graphql/index.d.ts"],
      "graphql/*": ["../../miniapps/keeris/node_modules/graphql/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../../curator/node_modules/@types",
      "../../server/node_modules/@types",
      "../../miniapps/keeris/node_modules/@types"
    ]
  },
  "include": ["src/**/*"]
}
