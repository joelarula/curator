{
  "name": "curator-gallery-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "gallery": "./bin/gallery.mjs"
  },
  "scripts": {
    "gallery": "node bin/gallery.mjs",
    "cli": "tsx src/cli.ts",
    "repl": "tsx src/cli.ts repl",
    "repl:direct": "tsx src/cli.ts repl --direct",
    "seed": "tsx src/cli.ts seed",
    "migrate:artm2": "tsx src/cli.ts migrate:artm2",
    "mcp": "tsx src/cli.ts mcp",
    "stats": "tsx src/cli.ts stats",
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:express --external:graphql --external:mysql2 --external:mariadb --external:@prisma/* --external:*/generated/prisma-sqlite/index.js --external:*/generated/prisma-mariadb/index.js --external:*/generated/prisma-postgres/index.js --external:better-sqlite3 --external:sharp --external:passport --external:passport-google-oauth20 --external:jsonwebtoken --outfile=app.js",
    "build:cpanel": "npm run build:web && npm run build:server",
    "package:cpanel": "node scripts/package-cpanel.js",
    "typecheck": "tsc --noEmit",
    "start": "node src/server/index.ts",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@curator/agent-server": "file:../../curator",
    "@curator/console": "file:../../packages/curator-console",
    "@curator/host": "file:../../packages/host",
    "@curator/mcp-server": "file:../../packages/mcp-server",
    "@curator/plugin-auth": "file:../../packages/plugin-auth",
    "@curator/plugin-image": "file:../../packages/plugin-image",
    "@curator/plugin-storage": "file:../../packages/plugin-storage",
    "@curator/server": "file:../../packages/server",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "commander": "^14.0.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "marked": "^16.4.2",
    "mysql2": "^3.12.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "vue": "^3.5.18",
    "vue-router": "^4.4.5",
    "vuetify": "^3.11.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vite": "^7.1.3",
    "vite-plugin-vuetify": "^2.1.2"
  }
}
