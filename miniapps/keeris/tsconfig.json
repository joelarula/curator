{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./web/src/*"],
      "@wasm/*": ["./wasm/*"],
      "@prisma/client": ["../../curator/src/generated/prisma-sqlite/index.d.ts"],
      "@curator/host": ["../../packages/host/src/index.ts"],
      "@curator/host/config": ["../../packages/host/src/appConfig.ts"],
      "@curator/host/contracts": ["../../packages/host/src/contracts/index.ts"],
      "@curator/host/client": ["../../packages/host/src/client/index.ts"],
      "@curator/host/*": ["../../packages/host/src/*"],
      "@curator/server": ["../../packages/server/src/index.ts"],
      "@curator/server/*": ["../../packages/server/src/*"],
      "@curator/console": ["../../packages/curator-console/src/index.ts"],
      "@curator/plugin-auth": ["../../packages/plugin-auth/src/index.ts"],
      "@curator/agent-server": ["../../curator/src/index.ts"],
      "@curator/ast": ["../../curator/src/engine/CuratorAst.ts"],
      "@curator/wasm-core": ["../../server/src/wasm-core/types.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "wasm/**/*.ts",
    "wasm/**/*.js",
    "web/src/**/*.ts",
    "web/src/**/*.d.ts",
    "web/src/**/*.tsx",
    "web/src/**/*.vue",
    "web/vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-dist"
  ]
}
