{
  "name": "keeris-kauamangiv-scraper",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "scrape": "node src/cli.ts scrape",
    "search": "node src/cli.ts search --artist=Keeris",
    "stats": "node src/cli.ts stats",
    "download:episode": "node scripts/download-episode.js",
    "setup:curator": "node src/setup-curator.ts",
    "prisma:setup": "prisma db push --schema=prisma/schema.prisma",
    "dev:server": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web:server": "vite build --config web/vite.config.ts --mode server",
    "build:web:wasm": "vite build --config web/vite.config.ts --mode wasm",
    "build:web": "npm run build:web:server",
    "build:all": "npm run build:web:server && npm run build:web:wasm",
    "preview:web": "vite preview --config web/vite.config.ts --mode server",
    "preview:static": "npx serve -s web-dist -p 3000 -c serve.json",
    "preview:wasm": "npx serve -s wasm-dist -p 3000 -c serve.json",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:express --external:graphql --external:mysql2 --external:cheerio --external:mariadb --external:@prisma/* --outfile=app.js",
    "build:cpanel": "npm run build:web:server && npm run build:server",
    "package:cpanel": "node scripts/package-cpanel.js",
    "build": "npm run build:web:server",
    "build:clean": "npm run build:web:server",
    "start": "node src/server/index.ts",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:run": "docker compose -f docker-compose.yml up",
    "deploy:remote": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-remote.ps1",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@curator/agent-server": "file:../../curator",
    "@curator/console": "file:../../packages/curator-console",
    "@mdi/js": "^7.4.47",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "@sqlite.org/sqlite-wasm": "^3.49.1-build1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "pg": "^8.23.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.4.5",
    "vuetify": "^3.11.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild": "^0.28.2",
    "prisma": "^7.6.0",
    "vite": "^7.1.3",
    "vite-plugin-vuetify": "^2.1.2"
  }
}
