{
  "name": "keeris-kauamangiv-scraper",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "scrape": "node src/cli.ts scrape",
    "rescrape:missing": "node scripts/rescrape-missing.mjs",
    "search": "node src/cli.ts search --artist=Keeris",
    "stats": "node src/cli.ts stats",
    "download:episode": "node scripts/download-episode.js",
    "setup:curator": "node src/setup-curator.ts",
    "prisma:setup": "prisma db push --schema=prisma/schema.prisma",
    "dev:server": "tsx src/server/index.ts",
    "dev:readonly": "tsx src/server/readonly-server.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web:server": "vite build --config web/vite.config.ts --mode server",
    "build:web:wasm": "vite build --config web/vite.config.ts --mode wasm",
    "build:web": "npm run build:web:server",
    "build:all": "npm run build:web:server && npm run build:web:wasm",
    "preview:web": "vite preview --config web/vite.config.ts --mode server",
    "preview:static": "npx serve -s web-dist -p 3000 -c serve.json",
    "preview:wasm": "npx serve -s wasm-dist -p 3000 -c serve.json",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:express --external:graphql --external:mysql2 --external:cheerio --external:mariadb --external:@prisma/* --external:passport --external:passport-google-oauth20 --external:jsonwebtoken --outfile=app.js",
    "build:server:readonly": "esbuild src/server/readonly-server.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:express --external:graphql --external:mysql2 --external:mariadb --external:pg --outfile=app-readonly.js",
    "build:readonly": "npm run build:web:server && npm run build:server:readonly",
    "package:readonly": "npm run build:readonly && node scripts/package-readonly.js",
    "build:cpanel": "npm run build:web:server && npm run build:server",
    "package:cpanel": "node scripts/package-cpanel.js",
    "build": "npm run build:web:server",
    "build:clean": "npm run build:web:server",
    "start": "node src/server/index.ts",
    "start:readonly": "node app-readonly.js",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:run": "docker compose -f docker-compose.yml up",
    "deploy:remote": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-remote.ps1",
    "sync:remote": "node scripts/sync-db-remote.mjs",
    "sync:remote:dry": "node scripts/sync-db-remote.mjs --dry-run",
    "sync:remote:clean": "node scripts/sync-db-remote.mjs --clean",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@curator/agent-server": "file:../../curator",
    "@curator/console": "file:../../packages/curator-console",
    "@curator/plugin-auth": "file:../../packages/plugin-auth",
    "@mdi/js": "^7.4.47",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "@sqlite.org/sqlite-wasm": "^3.49.1-build1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "mysql2": "^3.12.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.4.5",
    "vuetify": "^3.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/vite-plugin-vuetify": "^2.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild": "^0.28.2",
    "prisma": "^7.6.0",
    "tsx": "^4.23.12",
    "vite": "^7.1.3",
    "vite-plugin-vuetify": "^2.1.2"
  }
}
