{
  "name": "keeris-kauamangiv-scraper",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "scrape": "node src/cli.js scrape",
    "search": "node src/cli.js search --artist=Keeris",
    "stats": "node src/cli.js stats",
    "export:seed": "node scripts/export-seed-sqlite.js",
    "download:episode": "node scripts/download-episode.js",
    "setup:curator": "node src/setup-curator.js",
    "prisma:setup": "prisma db push --schema=prisma/schema.prisma",
    "dev:server": "node --watch src/server/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "build:web": "vite build --config web/vite.config.js",
    "build:server": "node --check src/server/server.js",
    "build": "npm run export:seed && npm run build:web",
    "start": "node src/server/server.js",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:logs": "docker compose -f docker-compose.yml logs -f",
    "docker:run": "docker compose -f docker-compose.yml up",
    "deploy:remote": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-remote.ps1",
    "test": "node --test"
  },
  "dependencies": {
    "@curator/agent-server": "file:../../curator",
    "@mdi/font": "^7.4.47",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "@sqlite.org/sqlite-wasm": "^3.49.1-build1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "pg": "^8.23.0",
    "vue": "^3.5.18",
    "vuetify": "^3.11.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "prisma": "^7.6.0",
    "vite": "^7.1.3",
    "vite-plugin-vuetify": "^2.1.2"
  }
}
