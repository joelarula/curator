{
  "name": "@curator/agent-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./*": "./dist/*"
  },
  "bin": {
    "curator": "dist/src/bin/cli.js"
  },
  "scripts": {
    "serve": "node --import tsx --max-old-space-size=4096 --no-warnings --watch src/bin/cli.ts serve",
    "cli": "node --import tsx --max-old-space-size=4096 --no-warnings src/bin/cli.ts run",
    "test": "node --import tsx --no-warnings --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --no-warnings --test \"test/compiler/*.test.ts\"",
    "test:process-feed:mock": "node --import tsx --no-warnings run_test_process_feed_with_mocks.ts",
    "build": "tsc",
    "start": "node dist/src/bin/cli.js serve",
    "cli:dist": "node dist/src/bin/cli.js run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:mariadb:generate": "prisma generate --schema=prisma-mariadb/schema.prisma"
  },
  "dependencies": {
    "@breejs/ts-worker": "^2.0.0",
    "@google/genai": "^2.29.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.6.0",
    "@prisma/client-runtime-utils": "7.10.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "bree": "^9.2.9",
    "coffeescript": "^2.7.0",
    "commander": "^14.0.2",
    "dotenv": "^16.6.1",
    "mariadb": "^3.5.4",
    "rss-parser": "^3.13.0",
    "tsx": "^4.19.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/coffeescript": "^2.5.7",
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.1",
    "prisma": "^7.6.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0"
  }
}
