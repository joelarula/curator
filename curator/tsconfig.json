{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "NodeNext",
    "target": "es2020",
    "moduleResolution": "NodeNext",
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@prisma/client": ["./src/generated/prisma-sqlite/index.d.ts"]
    },
    "noEmitOnError": false
  },
  "include": ["src/**/*", "prisma-sqlite/**/*", "prisma-mariadb/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
