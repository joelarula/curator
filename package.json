{
  "name": "curator-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "create:miniapp": "node scripts/create-miniapp.mjs",
    "install:all": "pnpm install",
    "dev:server": "pnpm --filter @curator/backend dev",
    "dev:frontend": "pnpm --filter @curator/frontend dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:frontend\"",
    "build": "pnpm -r run build",
    "build:static": "pnpm --filter @curator/frontend run build:static",
    "preview:static": "pnpm --filter @curator/frontend run preview:static",
    "poker": "pnpm --filter @minigames/poker run play --",
    "poker:direct": "pnpm --filter @minigames/poker run play:direct",
    "poker:serve": "pnpm --filter @minigames/poker run serve",
    "scrape:youtube": "pnpm --filter @curator/plugin-scraper scrape:youtube --",
    "yt": "pnpm --filter @curator/plugin-scraper yt --"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "concurrently": "^9.2.1",
    "prisma-erd-generator": "^2.4.2",
    "typescript": "^6.0.3",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "pino": "^10.3.1"
  }
}
