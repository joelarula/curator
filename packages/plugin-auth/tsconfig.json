{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": [
      "../../node_modules/@types",
      "../../miniapps/keeris/node_modules/@types",
      "../../server/node_modules/@types"
    ]
  },
  "include": ["src/**/*"]
}
