{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@curator/agent-server": ["../../curator/dist/src/index.d.ts"],
      "@curator/auth-client": ["../auth-client/dist/index.d.ts"],
      "@modelcontextprotocol/sdk/*": ["../../curator/node_modules/@modelcontextprotocol/sdk/dist/esm/*"]
    },
    "typeRoots": ["../../node_modules/@types", "../../curator/node_modules/@types"]
  },
  "include": ["src/**/*"]
}
