{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@curator/agent-server": ["../../curator/dist/src/index.d.ts"],
      "@curator/agent-server/*": ["../../curator/dist/src/*"],
      "@curator/host": ["../host/dist/index.d.ts"],
      "@curator/host/*": ["../host/dist/*"],
      "@curator/mcp-server": ["../mcp-server/dist/index.d.ts"],
      "@curator/mcp-server/*": ["../mcp-server/dist/*"],
      "@modelcontextprotocol/sdk": ["../../curator/node_modules/@modelcontextprotocol/sdk/dist/esm/index.d.ts"],
      "@modelcontextprotocol/sdk/*": ["../../curator/node_modules/@modelcontextprotocol/sdk/dist/esm/*"]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../../curator/node_modules/@types",
      "../../server/node_modules/@types"
    ]
  },
  "include": ["src/**/*"]
}
