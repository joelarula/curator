{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@curator/agent-server": ["../../curator/dist/src/index.d.ts"],
      "@curator/agent-server/*": ["../../curator/dist/src/*"],
      "@curator/host": ["../host/dist/index.d.ts"],
      "@curator/host/*": ["../host/dist/*"],
      "graphql": ["../../miniapps/blueprint/node_modules/graphql/index.d.ts"],
      "graphql/*": ["../../miniapps/blueprint/node_modules/graphql/*"],
      "express": ["../../miniapps/blueprint/node_modules/@types/express/index.d.ts"]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../../curator/node_modules/@types",
      "../../miniapps/blueprint/node_modules/@types",
      "../../miniapps/keeris/node_modules/@types",
      "../../server/node_modules/@types"
    ]
  },
  "include": ["src/**/*"]
}
