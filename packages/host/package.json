{
  "name": "@curator/host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/appConfig.d.ts",
      "import": "./dist/appConfig.js",
      "default": "./dist/appConfig.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    }
  },
  "bin": {
    "curator-seed": "./dist/bin/curator-seed.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/events.test.ts test/shell_auth.test.ts test/client_identity.test.ts test/app_config.test.ts test/single_node_conversations.test.ts test/role_based_conversations.test.ts test/conversation_session_lifecycle.test.ts"
  },
  "dependencies": {
    "@curator/agent-server": "file:../../curator",
    "@curator/plugin-auth": "file:../plugin-auth",
    "commander": "^14.0.2",
    "express": "^5.1.0",
    "graphql": "^16.14.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.1",
    "@types/ws": "^8.5.14",
    "typescript": "^5.6.2"
  }
}
